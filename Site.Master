<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="PsychologistWebApp.SiteMaster" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Thoughtful, collaborative therapy for adults navigating life's changes." />
    <title><%: Page.Title %> | Haven Psychology</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,600&display=swap" rel="stylesheet" />
    <link href="<%= ResolveUrl("~/Content/Site.css") %>" rel="stylesheet" />
    <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />
</head>
<body>
    <form runat="server">
        <a class="skip-link" href="#main-content">Skip to content</a>
        <header class="site-header">
            <div class="announcement">Now welcoming new clients for in-person and virtual care.</div>
            <div class="nav-wrap">
                <a class="brand" runat="server" href="~/" aria-label="Haven Psychology home">
                    <span class="brand-mark" aria-hidden="true">H</span>
                    <span>Haven <em>Psychology</em></span>
                </a>
                <nav class="site-nav" aria-label="Primary navigation">
                    <a runat="server" href="~/">Home</a>
                    <a runat="server" href="~/About">About</a>
                    <a href="#services">Services</a>
                    <a runat="server" href="~/Contact">Contact</a>
                </nav>
                <a class="button button-small" runat="server" href="~/Contact">Book a consultation <span aria-hidden="true">↗</span></a>
            </div>
        </header>
        <asp:ContentPlaceHolder ID="MainContent" runat="server" />
        <footer class="site-footer">
            <div class="footer-grid">
                <div>
                    <a class="brand footer-brand" runat="server" href="~/"><span class="brand-mark" aria-hidden="true">H</span><span>Haven <em>Psychology</em></span></a>
                    <p class="footer-intro">A calm, compassionate space to come back to yourself.</p>
                </div>
                <div>
                    <p class="footer-label">Explore</p>
                    <a runat="server" href="~/About">About</a>
                    <a href="#services">Services</a>
                    <a runat="server" href="~/Contact">Contact</a>
                </div>
                <div>
                    <p class="footer-label">Connect</p>
                    <a href="tel:+15550140248">(555) 014-0248</a>
                    <a href="mailto:hello@havenpsychology.com">hello@havenpsychology.com</a>
                    <p>Serving clients in California<br />and virtually statewide.</p>
                </div>
            </div>
            <div class="footer-bottom"><span>&copy; <%: DateTime.Now.Year %> Haven Psychology. All rights reserved.</span><span>This site is not monitored for emergencies. Call 911 for immediate support.</span></div>
        </footer>
    </form>
</body>
</html>
